<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LudoLegends" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_primary</item>
    </style>

    <style name="Theme.LudoLegends.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.LudoLegends</item>
    </style>
</resources>
